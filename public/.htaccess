<IfModule mod_headers.c>
  <FilesMatch "\.(?:html?)$">
    Header set Cache-Control "public, max-age=300, s-maxage=86400, stale-while-revalidate=86400, stale-if-error=604800"
  </FilesMatch>

  <FilesMatch "\.(?:css|js|png|jpe?g|webp|svg|ico|mp4|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
