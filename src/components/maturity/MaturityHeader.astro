---
import { withMaturityRelease } from "../../lib/maturity-state.mjs";
interface Props { compact?: boolean; cta?: boolean }
const { compact = false, cta = true } = Astro.props;
const homeHref = withMaturityRelease("/teste-maturidade-comercial/");
const startHref = withMaturityRelease("/teste-maturidade-comercial/dados-iniciais/");
---
<header class:list={["maturity-header", { "is-compact": compact }]}>
  <div class="maturity-container maturity-header__inner">
    <a class="maturity-brand" href={homeHref} aria-label="Raevo — Teste de Maturidade Comercial">
      <img src="/assets/brand/raevo-logo-official-transparent.png" width="755" height="166" alt="Raevo" />
    </a>
    <span class="maturity-header__label">Teste de Maturidade Comercial</span>
    {cta && <a class="maturity-button maturity-button--dark maturity-header__cta" href={startHref}>Começar o teste <span aria-hidden="true">→</span></a>}
  </div>
</header>
