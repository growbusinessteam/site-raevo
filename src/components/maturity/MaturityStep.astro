---
import type { MaturityQuestion, MaturityStep as Step } from "../../data/maturity";
import { withMaturityRelease } from "../../lib/maturity-state.mjs";
import MaturityHeader from "./MaturityHeader.astro";

interface Props {
  step: Step | MaturityQuestion;
  kind: "context" | "question";
  index: number;
  total: number;
  previousPath: string;
  nextPath: string;
}
const { step, kind, index, total, previousPath, nextPath } = Astro.props;
const isQuestion = kind === "question";
const progress = Math.round(((index + 1) / total) * 100);
const stepLabel = isQuestion ? `Pergunta ${index + 1} de ${total}` : `Contexto ${index + 1} de ${total}`;
const versionedPreviousPath = withMaturityRelease(previousPath);
const versionedNextPath = withMaturityRelease(nextPath);
---
<MaturityHeader compact cta={false} />
<main id="conteudo" class="maturity-step-page" data-step-key={step.key} data-step-kind={kind} data-step-number={isQuestion ? index + 1 : ""} data-next-path={versionedNextPath} data-maturity-step>
  <div class="maturity-step-page__grid" aria-hidden="true"></div>
  <div class="maturity-step-shell">
    <div class="maturity-step-meta">
      <span>{isQuestion ? (step as MaturityQuestion).pillarLabel : "Contexto da empresa"}</span>
      <span>{stepLabel}</span>
    </div>
    <div class="maturity-step-progress" aria-label={`${progress}% concluído`}><i style={`width:${progress}%`}></i></div>
    <div class="maturity-step-progress__label"><span>{progress}% concluído</span><span>{isQuestion ? "18 perguntas" : `${total} perguntas de contexto`}</span></div>
    <form class="maturity-step-form" novalidate>
      <fieldset>
        <legend>{step.question}</legend>
        {step.helper && <p class="maturity-step-helper">{step.helper}</p>}
        <div class="maturity-options" role="radiogroup">
          {step.options.map((answer, answerIndex) => (
            <label class="maturity-option">
              <input type="radio" name="answer" value={answer.value} data-score={answer.score} />
              <span class="maturity-option__marker">{String.fromCharCode(65 + answerIndex)}</span>
              <span class="maturity-option__text">{answer.label}</span>
              <span class="maturity-option__check" aria-hidden="true">✓</span>
            </label>
          ))}
        </div>
      </fieldset>
      <p class="maturity-step-error" data-step-error aria-live="polite"></p>
      <div class="maturity-step-actions">
        <a class="maturity-back" data-back href={versionedPreviousPath}><span aria-hidden="true">←</span> Voltar</a>
        <button class="maturity-button maturity-button--gold" data-continue type="submit" disabled>Continuar <span aria-hidden="true">→</span></button>
      </div>
    </form>
  </div>
</main>
<script>
  import { FUNNEL_PATHS, LEAD_PATH, ensureBrowserState, getFirstIncompletePath, saveBrowserState, setContextAnswer, setMaturityAnswer, withMaturityRelease } from "../../lib/maturity-state.mjs";
  const page = document.querySelector(".maturity-step-page[data-maturity-step]");
  const form = page?.querySelector("form");
  if (page instanceof HTMLElement && form instanceof HTMLFormElement) {
    const AUTO_ADVANCE_DELAY_MS = 180;
    let state = ensureBrowserState();
    let isAdvancing = false;
    const currentPath = window.location.pathname.endsWith("/") ? window.location.pathname : `${window.location.pathname}/`;
    const expectedPath = getFirstIncompletePath(state);
    const currentIndex = FUNNEL_PATHS.indexOf(currentPath);
    const expectedIndex = FUNNEL_PATHS.indexOf(expectedPath);
    if (expectedPath === LEAD_PATH || (currentIndex > expectedIndex && expectedIndex >= 0)) window.location.replace(withMaturityRelease(expectedPath));

    const kind = page.dataset.stepKind;
    const key = page.dataset.stepKey ?? "";
    const number = Number(page.dataset.stepNumber);
    const savedValue = kind === "question" ? state.answers[String(number)] : state.context[key];
    const radios = Array.from(form.querySelectorAll('input[name="answer"]'));
    const continueButton = form.querySelector("[data-continue]");
    const error = form.querySelector("[data-step-error]");
    const nextPath = () => page.dataset.nextPath ?? getFirstIncompletePath(state);
    const navigate = () => window.location.assign(withMaturityRelease(nextPath()));
    const advance = () => {
      if (isAdvancing) return;
      isAdvancing = true;
      form.classList.add("is-advancing");
      radios.forEach((radio) => { radio.disabled = true; });
      if (continueButton instanceof HTMLButtonElement) continueButton.disabled = true;
      window.setTimeout(navigate, AUTO_ADVANCE_DELAY_MS);
    };
    const select = (radio) => {
      if (!(radio instanceof HTMLInputElement)) return;
      radio.checked = true;
      if (continueButton instanceof HTMLButtonElement) continueButton.disabled = false;
      if (error) error.textContent = "";
      state = kind === "question" ? setMaturityAnswer(state, number, Number(radio.dataset.score)) : setContextAnswer(state, key, radio.value);
      saveBrowserState(state);
    };
    radios.forEach((radio) => {
      if (String(kind === "question" ? radio.dataset.score : radio.value) === String(savedValue)) select(radio);
      radio.addEventListener("click", () => { select(radio); advance(); });
    });
    form.addEventListener("keydown", (event) => {
      if (!["ArrowDown", "ArrowRight", "ArrowUp", "ArrowLeft"].includes(event.key)) return;
      event.preventDefault();
      const selected = Math.max(0, radios.findIndex((radio) => radio.checked));
      const delta = ["ArrowDown", "ArrowRight"].includes(event.key) ? 1 : -1;
      const target = radios[(selected + delta + radios.length) % radios.length];
      select(target); target?.focus();
    });
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const selected = radios.find((radio) => radio.checked);
      if (!selected) { if (error) error.textContent = "Escolha a alternativa que melhor representa a realidade atual."; radios[0]?.focus(); return; }
      navigate();
    });
  }
</script>
