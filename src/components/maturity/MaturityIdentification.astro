---
import MaturityHeader from "./MaturityHeader.astro";
import { improvementTimelines, maturityRoles } from "../../data/maturity";
---
<MaturityHeader compact cta={false} />
<main id="conteudo" class="maturity-identification-page">
  <div class="maturity-step-page__grid" aria-hidden="true"></div>
  <div class="maturity-identification-shell">
    <div class="maturity-identification-intro">
      <p class="maturity-eyebrow">A sua análise está pronta</p>
      <h1>Falta apenas identificar o resultado.</h1>
      <p>Complete os dados profissionais para gerar o diagnóstico personalizado e o relatório em PDF.</p>
      <div class="maturity-identification-note"><span>01</span><p>O seu nome, WhatsApp e setor já foram guardados no início do teste.</p></div>
      <div class="maturity-identification-note"><span>02</span><p>O resultado é baseado apenas nas respostas fornecidas e não representa um benchmark de mercado.</p></div>
    </div>
    <form class="maturity-identification-form" data-identification-form novalidate>
      <div class="maturity-field"><label for="maturity-company">Empresa</label><input id="maturity-company" name="company" type="text" autocomplete="organization" placeholder="Nome da empresa" /><p data-error="company" aria-live="polite"></p></div>
      <div class="maturity-field"><label for="maturity-role">Cargo ou função</label><select id="maturity-role" name="role"><option value="">Escolha uma opção</option>{maturityRoles.map((role) => <option value={role}>{role}</option>)}</select><p data-error="role" aria-live="polite"></p></div>
      <div class="maturity-field"><label for="maturity-email">E-mail profissional</label><input id="maturity-email" name="email" type="email" inputmode="email" autocomplete="email" placeholder="nome@empresa.pt" /><p data-error="email" aria-live="polite"></p></div>
      <div class="maturity-field"><label for="maturity-website">Site ou Instagram <span>Opcional</span></label><input id="maturity-website" name="website" type="text" autocomplete="url" placeholder="empresa.pt ou @empresa" /><p data-error="website" aria-live="polite"></p></div>
      <div class="maturity-field"><label for="maturity-timeline">Quando pretende melhorar o processo comercial?</label><select id="maturity-timeline" name="timeline"><option value="">Escolha uma opção</option>{improvementTimelines.map((timeline) => <option value={timeline}>{timeline}</option>)}</select><p data-error="timeline" aria-live="polite"></p></div>
      <div class="maturity-consents">
        <label><input type="checkbox" name="privacyAccepted" /><span>Li e aceito a <a href="/privacidade/" target="_blank">Política de Privacidade</a>.</span></label><p data-error="privacyAccepted" aria-live="polite"></p>
        <label><input type="checkbox" name="marketingAccepted" /><span>Aceito receber conteúdos e comunicações da Raevo. <em>Opcional</em></span></label>
      </div>
      <p class="maturity-submit-error" data-submit-error aria-live="assertive"></p>
      <div class="maturity-identification-actions"><a class="maturity-back" href="/teste-maturidade-comercial/pergunta/18/"><span aria-hidden="true">←</span> Voltar</a><button class="maturity-button maturity-button--gold" type="submit" data-submit>Ver o meu resultado <span aria-hidden="true">→</span></button></div>
    </form>
  </div>
</main>
<script>
  import { buildSubmissionPayload, createIdempotencyKey, validateIdentification } from "../../lib/maturity-form.mjs";
  import { clearBrowserState, getFirstIncompletePath, loadBrowserState } from "../../lib/maturity-state.mjs";
  const form = document.querySelector("[data-identification-form]");
  const state = loadBrowserState();
  if (!state) window.location.replace("/teste-maturidade-comercial/dados-iniciais/");
  else {
    const incomplete = getFirstIncompletePath(state);
    if (incomplete !== "/teste-maturidade-comercial/identificacao/") window.location.replace(incomplete);
  }
  if (form instanceof HTMLFormElement && state) {
    const submit = form.querySelector("[data-submit]");
    const submitError = form.querySelector("[data-submit-error]");
    const idempotencyKey = createIdempotencyKey();
    const getValues = () => {
      const data = new FormData(form);
      return { company: data.get("company"), role: data.get("role"), email: data.get("email"), website: data.get("website"), timeline: data.get("timeline"), privacyAccepted: data.get("privacyAccepted") === "on", marketingAccepted: data.get("marketingAccepted") === "on" };
    };
    const clearErrors = () => form.querySelectorAll("[data-error],[data-submit-error]").forEach((element) => { element.textContent = ""; });
    const showError = (error) => { const target = form.querySelector(`[data-error="${error.field}"]`); if (target) target.textContent = error.message; form.elements.namedItem(error.field)?.focus(); };
    form.addEventListener("input", (event) => { const field = event.target instanceof HTMLInputElement || event.target instanceof HTMLSelectElement ? event.target.name : ""; const target = form.querySelector(`[data-error="${field}"]`); if (target) target.textContent = ""; });
    form.addEventListener("submit", async (event) => {
      event.preventDefault(); clearErrors();
      const values = getValues(); const error = validateIdentification(values);
      if (error) { showError(error); return; }
      if (submit instanceof HTMLButtonElement) { submit.disabled = true; submit.setAttribute("aria-busy", "true"); submit.childNodes[0].textContent = "A gerar a análise "; }
      try {
        const response = await fetch("/api/maturidade/submissions", { method: "POST", headers: { "Content-Type": "application/json", "X-Idempotency-Key": idempotencyKey }, body: JSON.stringify(buildSubmissionPayload(values, state, { idempotencyKey })) });
        const data = await response.json().catch(() => ({}));
        if (!response.ok || !data.result_url) throw new Error(data.message || "Não foi possível gerar o resultado agora.");
        clearBrowserState(); window.location.assign(data.result_url);
      } catch (error) {
        if (submitError) submitError.textContent = error instanceof Error ? error.message : "Não foi possível gerar o resultado agora. Tente novamente.";
        if (submit instanceof HTMLButtonElement) { submit.disabled = false; submit.setAttribute("aria-busy", "false"); submit.childNodes[0].textContent = "Ver o meu resultado "; }
      }
    });
  }
</script>
