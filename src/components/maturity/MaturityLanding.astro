---
import MaturityHeader from "./MaturityHeader.astro";
import MaturityFooter from "./MaturityFooter.astro";
import { maturityLevels, maturityPillars } from "../../data/maturity";
import { withMaturityRelease } from "../../lib/maturity-state.mjs";

const startHref = withMaturityRelease("/teste-maturidade-comercial/dados-iniciais/");
const discoveries = [
  ["O seu nível atual", "Descubra a percentagem de maturidade comercial da sua empresa e em que nível ela se encontra."],
  ["Os principais bloqueios", "Identifique as áreas que mais limitam a conversão e a previsibilidade dos resultados."],
  ["O próximo passo", "Receba prioridades claras para avançar para o próximo nível de maturidade."],
];
const pillarDetails = [
  ["crosshair", "Origem, qualidade e previsibilidade das novas oportunidades."],
  ["response", "Velocidade, padrão de contacto e critérios de qualificação."],
  ["path", "Etapas, responsabilidades e próximos passos da jornada."],
  ["pipeline", "Centralização, follow-up e reativação de oportunidades."],
  ["bars", "Conversões, motivos de perda e rotina de decisão."],
  ["nodes", "Integrações, automações e utilização estruturada de IA."],
];
const iconPaths: Record<string, string> = {
  crosshair: "M12 3v3m0 12v3M3 12h3m12 0h3m-5 0a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z",
  response: "M5 5h14v10H9l-4 4V5Zm4 4h6m-6 3h4",
  path: "M5 5h5v5H5V5Zm9 9h5v5h-5v-5ZM10 7.5h3a3 3 0 0 1 3 3V14",
  pipeline: "M5 5h14v4H5V5Zm0 10h14v4H5v-4Zm4-6v6m6-6v6",
  bars: "M5 19V9m5 10V5m5 14v-7m4 7V3",
  nodes: "M6 8a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm12 12a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM6 6h7a5 5 0 0 1 5 5v5M8 18h4",
};
---
<MaturityHeader />
<main id="conteudo">
  <section class="maturity-hero">
    <div class="maturity-hero__grid" aria-hidden="true"></div>
    <div class="maturity-container maturity-hero__content" data-reveal>
      <p class="maturity-eyebrow">Teste gratuito · Cerca de 5 minutos</p>
      <h1>Qual é o nível de maturidade comercial da sua empresa?</h1>
      <p class="maturity-hero__copy">Avalie o seu processo comercial e descubra se a sua empresa está num nível inicial, reativo, estruturado, previsível ou inteligente.</p>
      <p class="maturity-hero__copy maturity-hero__copy--secondary">Receba uma análise personalizada com os principais pontos de evolução.</p>
      <a class="maturity-button maturity-button--gold" href={startHref}>Começar o teste <span aria-hidden="true">→</span></a>
      <p class="maturity-microcopy">Resultado imediato <i></i> Relatório visual personalizado <i></i> Sem compromisso</p>
    </div>
    <div class="maturity-container maturity-scale" aria-label="Escala de maturidade comercial" data-reveal>
      {maturityLevels.map((level, index) => <div><span>{String(index + 1).padStart(2, "0")}</span><strong>{level.label}</strong></div>)}
    </div>
  </section>

  <section class="maturity-section maturity-discoveries">
    <div class="maturity-container">
      <div class="maturity-section__intro" data-reveal><p class="maturity-eyebrow">O que irá descobrir</p><h2>Mais do que uma pontuação.</h2><p>O teste analisa os principais elementos que transformam oportunidades comerciais em crescimento previsível.</p></div>
      <div class="maturity-discovery-grid">
        {discoveries.map(([title, body], index) => <article data-reveal><span>{String(index + 1).padStart(2, "0")}</span><h3>{title}</h3><p>{body}</p></article>)}
      </div>
    </div>
  </section>

  <section class="maturity-section maturity-pillars">
    <div class="maturity-container">
      <div class="maturity-section__intro maturity-section__intro--light" data-reveal><p class="maturity-eyebrow">O que será avaliado</p><h2>Seis áreas do seu sistema comercial.</h2><p>Uma leitura integrada da forma como a empresa gera, conduz e transforma oportunidades em vendas.</p></div>
      <div class="maturity-pillar-grid">
        {maturityPillars.map((pillar, index) => <article data-reveal><svg viewBox="0 0 24 24" aria-hidden="true"><path d={iconPaths[pillarDetails[index][0]]}></path></svg><div><span>0{index + 1}</span><h3>{pillar.label}</h3><p>{pillarDetails[index][1]}</p></div></article>)}
      </div>
    </div>
  </section>

  <section class="maturity-section maturity-how">
    <div class="maturity-container maturity-how__layout">
      <div class="maturity-section__intro" data-reveal><p class="maturity-eyebrow">Como funciona</p><h2>Uma leitura clara em três momentos.</h2></div>
      <ol>
        <li data-reveal><span>01</span><div><h3>Responda a 18 perguntas</h3><p>Avalie como a empresa gera, atende, acompanha e converte oportunidades.</p></div></li>
        <li data-reveal><span>02</span><div><h3>Receba o resultado</h3><p>Descubra a percentagem de maturidade e o desempenho em cada área.</p></div></li>
        <li data-reveal><span>03</span><div><h3>Conheça as prioridades</h3><p>Receba insights e recomendações para avançar para o próximo nível.</p></div></li>
      </ol>
    </div>
  </section>

  <section class="maturity-section maturity-report-preview">
    <div class="maturity-container maturity-report-preview__layout">
      <div class="maturity-section__intro" data-reveal><p class="maturity-eyebrow">Relatório personalizado</p><h2>Um relatório construído a partir das suas respostas.</h2><p>Veja o nível atual, o desempenho por pilar e as prioridades que merecem atenção primeiro.</p><a class="maturity-text-link" href={startHref}>Começar a minha análise <span aria-hidden="true">→</span></a></div>
      <div class="maturity-report-card" data-reveal>
        <div class="maturity-report-card__top"><span>Exemplo de resultado</span><strong>RAEVO</strong></div>
        <div class="maturity-report-card__score"><div><strong>57%</strong><span>Estruturado</span></div><p>Parte importante da estrutura já existe. A evolução está em torná-la consistente e mensurável.</p></div>
        <div class="maturity-report-card__bars"><p><span>Geração de oportunidades</span><b>75%</b><i><em style="width:75%"></em></i></p><p><span>CRM e acompanhamento</span><b>33%</b><i><em style="width:33%"></em></i></p><p><span>Dados e gestão</span><b>58%</b><i><em style="width:58%"></em></i></p></div>
        <div class="maturity-report-card__footer"><span>Insight Raevo</span><span>Prioridades</span><span>Próximo passo</span></div>
      </div>
    </div>
  </section>

  <section class="maturity-final-cta"><div class="maturity-container" data-reveal><p class="maturity-eyebrow">O próximo passo começa com clareza</p><h2>Descubra o que está a limitar o crescimento comercial da sua empresa.</h2><p>Em poucos minutos, terá uma visão mais clara da sua estrutura comercial e dos próximos passos necessários para evoluir.</p><a class="maturity-button maturity-button--gold" href={startHref}>Começar o teste <span aria-hidden="true">→</span></a></div></section>
</main>
<MaturityFooter />
<script>
  import { createAssessmentState, loadBrowserState, saveBrowserState } from "../../lib/maturity-state.mjs";
  if (!loadBrowserState()) saveBrowserState(createAssessmentState({ href: window.location.href, referrer: document.referrer }));
</script>
