---
import type { OfficialContent } from "../../data/official";
import OfficialLayout from "./OfficialLayout.astro";
import OfficialHeader from "./OfficialHeader.astro";
import OfficialFooter from "./OfficialFooter.astro";
import CommercialSystem from "./CommercialSystem.astro";
const { content } = Astro.props as { content: OfficialContent };
const logos = [
  ["humberto-neto.png", "Humberto Neto"], ["conmed.png", "Conmed"], ["citocenter.png", "Citocenter"],
  ["facop-dental-school.png", "FACOP Dental School"], ["espaco-otorrino.png", "Espaço Otorrino"],
  ["itc.png", "ITC"], ["carla-barata.png", "Carla Barata"],
];
---
<OfficialLayout {content} enableGoogleTagManager>
  <OfficialHeader {content} />
  <main>
    <section class="official-hero" id="home">
      <video autoplay muted loop playsinline poster="/assets/video/raevo-oficial-hero-poster.jpg" aria-hidden="true">
        <source src="/assets/video/raevo-oficial-hero.mp4" type="video/mp4" />
      </video>
      <div class="hero-overlay"></div>
      <div class="official-container hero-content reveal">
        <p class="eyebrow light">{content.hero.eyebrow}</p>
        <h1>{content.hero.title}</h1>
        <p class="hero-copy">{content.hero.body}</p>
        <div class="hero-actions">
          <a class="button button-gold" href="#sistema">{content.hero.cta}<span aria-hidden="true">→</span></a>
          <a class="text-link light" href="#solucoes">{content.hero.secondary}<span aria-hidden="true">↓</span></a>
        </div>
      </div>
      <div class="hero-marker" aria-hidden="true"><span>RAEVO</span><i></i><span>2026</span></div>
    </section>

    <section class="clients-strip" aria-label={content.labels.clients}>
      <div class="official-container">
        <p class="eyebrow">{content.labels.clients}</p>
        <div class="logo-row">{logos.map(([file, alt]) => <div class="logo-card"><img src={`/assets/client-logos/${file}`} alt={alt} loading="lazy" /></div>)}</div>
      </div>
    </section>

    <section class="section section-problems" id="problema">
      <div class="official-container">
        <div class="section-intro reveal">
          <p class="eyebrow">{content.labels.problemsEyebrow}</p>
          <h2>{content.labels.problemsTitle}</h2>
          <p>{content.labels.problemsBody}</p>
        </div>
        <div class="problem-grid">
          {content.problems.map((item, index) => (
            <article class="problem-card reveal">
              <span>{String(index + 1).padStart(2, "0")}</span><h3>{item.title}</h3><p>{item.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-system" id="sistema">
      <div class="official-container">
        <div class="section-intro system-intro reveal">
          <p class="eyebrow light">{content.labels.systemEyebrow}</p>
          <h2>{content.labels.systemTitle}</h2>
          <p>{content.labels.systemBody}</p>
        </div>
        <CommercialSystem steps={content.journey} />
        <div class="system-result reveal"><span class="material-symbols-outlined">all_inclusive</span><p><strong>Um sistema, não um conjunto de ferramentas.</strong><br />Cada etapa alimenta a próxima e devolve informação para melhorar a operação.</p></div>
      </div>
    </section>

    <section class="section section-solutions" id="solucoes">
      <div class="official-container">
        <div class="section-intro reveal">
          <p class="eyebrow">{content.labels.solutionsEyebrow}</p><h2>{content.labels.solutionsTitle}</h2>
        </div>
        <div class="solutions-grid">
          {content.solutions.map((solution) => (
            <article class="solution-card reveal">
              <span class="material-symbols-outlined solution-icon">{solution.icon}</span>
              <h3>{solution.title}</h3><p>{solution.body}</p><p class="solution-outcome">{solution.outcome}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-method" id="metodo">
      <div class="official-container method-layout">
        <div class="section-intro reveal"><p class="eyebrow">{content.labels.methodEyebrow}</p><h2>{content.labels.methodTitle}</h2></div>
        <ol class="method-list">
          {content.method.map((item, index) => <li class="reveal"><span>{String(index + 1).padStart(2, "0")}</span><div><h3>{item.title}</h3><p>{item.body}</p></div></li>)}
        </ol>
      </div>
    </section>

    <section class="section section-portfolio" id="portfolio">
      <div class="official-container portfolio-layout">
        <div class="portfolio-image reveal"><img src="/assets/landing-3/raevo-equipe.png" alt="Equipa Raevo" /><div class="image-label">Estratégia + implementação + acompanhamento</div></div>
        <div class="section-intro reveal"><p class="eyebrow">{content.labels.portfolioEyebrow}</p><h2>{content.labels.portfolioTitle}</h2><p>{content.labels.portfolioBody}</p><a class="text-link" href={content.formHref}>Conhecer a Raevo <span aria-hidden="true">→</span></a></div>
      </div>
    </section>

    <section class="section section-audience">
      <div class="official-container"><div class="section-intro reveal"><p class="eyebrow">Encaixe</p><h2>{content.labels.audienceTitle}</h2></div>
        <div class="audience-grid">{content.audience.map((item) => <article class="reveal"><span class="material-symbols-outlined">check_circle</span><h3>{item.title}</h3><p>{item.body}</p></article>)}</div>
      </div>
    </section>

    <section class="final-cta" id="contato">
      <div class="official-container reveal"><p class="eyebrow light">Próximo passo</p><h2>{content.labels.finalTitle}</h2><p>{content.labels.finalBody}</p><a class="button button-gold" href={content.formHref}>{content.labels.finalCta}<span aria-hidden="true">→</span></a></div>
    </section>
  </main>
  <OfficialFooter {content} />
</OfficialLayout>
<script>
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!reduced && "IntersectionObserver" in window) {
    document.documentElement.classList.add("motion-ready");
    const observer = new IntersectionObserver((entries) => entries.forEach((entry) => {
      if (entry.isIntersecting) { entry.target.classList.add("is-visible"); observer.unobserve(entry.target); }
    }), { threshold: .12 });
    document.querySelectorAll(".reveal").forEach((element) => observer.observe(element));
  }
</script>
